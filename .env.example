# 複製這個檔成 .env，填入你的 FinMind token
# 到 https://finmindtrade.com 註冊（免費）→ 會員中心拿 API token
FINMIND_TOKEN=

# Gemini（AI 摘要用，與 GAS 晨報同一把 key；在 GAS 專案設定→指令碼屬性 GEMINI_KEY）
GEMINI_KEY=
# 可選，預設 gemini-3.1-flash-lite（留空會出錯，不填就整行刪掉或註解）
# GEMINI_MODEL=gemini-3.1-flash-lite

# 國際情勢專家：美國官方總經（CPI/Fed利率/公債殖利率）。免費申請：
# https://fredaccount.stlouisfed.org/apikeys （沒填只會少這三個數字，台幣/費半/VIX 照常）
FRED_KEY=

# 📲 Telegram 推播（找 @BotFather /newbot 拿 token；chat_id 用 notify.get_chat_id() 查）
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
